{
  "name": "sluice-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Sluice's Telegram bot: alerts to the right founder, read commands, and guardian actions that only make a vault stricter",
  "scripts": {
    "start": "node --max-old-space-size=128 dist/main.mjs",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --minify --legal-comments=none --outfile=dist/main.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "dev": "tsx src/main.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tsx": "^4.19.2",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.23.1",
    "typescript": "^5.6.3"
  }
}
