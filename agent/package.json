{
  "name": "sluice-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Sluice's agent: settles bills inside the vault's limits, proposes the rest",
  "scripts": {
    "agent": "tsx src/main.ts",
    "dry-run": "tsx src/main.ts --dry-run",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --minify --legal-comments=none --outfile=dist/main.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "agent:prod": "node --max-old-space-size=192 dist/main.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
